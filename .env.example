# Copy this file to .env.local for local development.
# Set the absolute path to your video directory.
VIDEO_ROOT=/absolute/path/to/videos

# Optional comma-separated hostnames for development access from other devices.
# ALLOWED_DEV_ORIGINS=dev.example.test,*.local

# Optional advanced overrides. SYKB normally uses its in-app setup wizard.
# BAIDUPCS_GO_PATH=/usr/local/bin/BaiduPCS-Go
# BAIDUPCS_GO_CONFIG_DIR=/absolute/path/to/baidupcs-config
