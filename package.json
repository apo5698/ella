{
  "name": "ella",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prettier --check . && next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:tags": "tsx tests/check-tag-order.ts && tsx tests/check-tag-hierarchy.ts",
    "check:releases": "node --import tsx --test tests/releases.test.ts && node --test tests/release-rules.test.mjs",
    "check:updates": "node --experimental-test-module-mocks --import tsx --test tests/updater.test.ts tests/dbBackup.test.ts && python3 -B -m unittest discover -s deploy/updater -p 'test_*.py'"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "@base-ui/react": "^1.7.0",
    "@shikijs/transformers": "^4.4.3",
    "@tanstack/react-form": "^1.33.5",
    "@vidstack/react": "^1.15.6",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.3.2",
    "diff": "^9.0.0",
    "lucide-react": "^1.33.0",
    "next": "16.3.1",
    "next-intl": "^4.14.2",
    "next-themes": "^0.4.6",
    "pinyin-pro": "^3.29.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "semver": "^7.8.5",
    "shadcn": "^4.19.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.9",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/semver": "^7.8.0",
    "conventional-changelog-conventionalcommits": "9",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "prettier": "3.9.6",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  },
  "trustedDependencies": [
    "better-sqlite3",
    "esbuild",
    "unrs-resolver"
  ]
}
